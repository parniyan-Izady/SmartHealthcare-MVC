@model AppointmentDetailsViewModel
@{
    ViewData["Title"] = "Appointment Details";
}

<div class="max-w-3xl mx-auto space-y-6">
    <a asp-action="Index" class="inline-flex items-center gap-2 text-xs font-semibold text-slate-500 hover:text-teal-600">
        <i class="fa-solid fa-arrow-left"></i> Back to Appointments
    </a>

    <!-- Appointment Overview Card -->
    <div class="bg-white p-8 rounded-2xl border border-slate-200 shadow-sm space-y-6">
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 border-b border-slate-100 pb-6">
            <div>
                <span class="text-xs font-mono text-slate-400 block mb-1">ID: @Model.Appointment.Id</span>
                <h1 class="text-2xl font-bold text-slate-900">Clinical Consultation</h1>
            </div>
            <div>
                <span class="px-3 py-1.5 text-xs font-semibold rounded-full 
                    @(Model.Appointment.Status == "Scheduled" ? "bg-blue-50 text-blue-700 border border-blue-200" :
                      Model.Appointment.Status == "Completed" ? "bg-emerald-50 text-emerald-700 border border-emerald-200" : "bg-red-50 text-red-700 border border-red-200")">
                    @Model.Appointment.Status
                </span>
            </div>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-6 text-sm">
            <div class="p-4 bg-slate-50 rounded-xl space-y-2">
                <span class="text-xs font-semibold text-slate-400 uppercase tracking-wider block">Patient</span>
                <p class="font-bold text-slate-900 text-base">@Model.Appointment.PatientName</p>
                <p class="text-xs text-slate-500 font-mono">Patient ID: @Model.Appointment.PatientId</p>
            </div>

            <div class="p-4 bg-slate-50 rounded-xl space-y-2">
                <span class="text-xs font-semibold text-slate-400 uppercase tracking-wider block">Attending Doctor</span>
                <p class="font-bold text-slate-900 text-base">@Model.Appointment.DoctorName</p>
                <p class="text-xs text-slate-500 font-mono">Doctor ID: @Model.Appointment.DoctorId</p>
            </div>
        </div>

        <div class="space-y-4 pt-2">
            <div>
                <span class="text-xs font-semibold text-slate-400 uppercase tracking-wider block">Scheduled Schedule (UTC)</span>
                <p class="font-medium text-slate-800 text-base mt-1">
                    <i class="fa-regular fa-clock text-teal-600 mr-1.5"></i>
                    @Model.Appointment.StartUtc.ToString("dddd, MMMM dd, yyyy 'at' HH:mm") - @Model.Appointment.EndUtc.ToString("HH:mm") UTC
                </p>
            </div>

            <div>
                <span class="text-xs font-semibold text-slate-400 uppercase tracking-wider block">Reason for Visit / Symptoms</span>
                <p class="p-3 bg-slate-50 rounded-xl text-slate-700 text-sm mt-1">
                    @(string.IsNullOrEmpty(Model.Appointment.ReasonForVisit) ? "No specific reason provided." : Model.Appointment.ReasonForVisit)
                </p>
            </div>
        </div>

        <!-- Action Buttons (Complete / Cancel) -->
        @if (Model.Appointment.Status == "Scheduled")
        {
            <div class="pt-6 border-t border-slate-100 flex flex-col sm:flex-row items-center justify-between gap-4">
                @if (User.IsInRole("Admin") || User.IsInRole("Doctor"))
                {
                    <form asp-action="Complete" asp-route-id="@Model.Appointment.Id" method="post" class="w-full sm:w-auto">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="w-full sm:w-auto px-5 py-2.5 bg-emerald-600 hover:bg-emerald-700 text-white text-sm font-medium rounded-xl shadow-sm transition flex items-center justify-center gap-2">
                            <i class="fa-solid fa-check"></i> Mark as Completed
                        </button>
                    </form>
                }

                <!-- Cancel with reason prompt -->
                <form asp-action="Cancel" asp-route-id="@Model.Appointment.Id" method="post" class="w-full sm:w-auto flex items-center gap-2">
                    @Html.AntiForgeryToken()
                    <input type="text" name="reason" placeholder="Cancellation reason..." required
                           class="px-3 py-2 rounded-xl border border-slate-300 text-sm focus:outline-none focus:ring-2 focus:ring-red-500" />
                    <button type="submit" class="px-4 py-2 bg-red-600 hover:bg-red-700 text-white text-sm font-medium rounded-xl transition">
                        Cancel
                    </button>
                </form>
            </div>
        }
    </div>
</div>
