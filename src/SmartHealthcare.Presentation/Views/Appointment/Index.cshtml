@model AppointmentListViewModel
@{
    ViewData["Title"] = "Clinical Appointments";
}

<div class="space-y-6">
    <!-- Header with Action -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
        <div>
            <h1 class="text-2xl font-bold text-slate-900 tracking-tight">Appointments Directory</h1>
            <p class="text-slate-500 text-sm mt-0.5">Manage patient consultations, visit schedules, and statuses</p>
        </div>
        <a asp-action="Book" class="inline-flex items-center gap-2 px-4 py-2.5 bg-teal-600 hover:bg-teal-700 text-white text-sm font-medium rounded-xl shadow-sm transition">
            <i class="fa-solid fa-calendar-plus text-xs"></i> Book New Appointment
        </a>
    </div>

    <!-- Filter Bar -->
    <form method="get" asp-action="Index" class="bg-white p-4 rounded-2xl border border-slate-200 shadow-sm grid grid-cols-1 sm:grid-cols-4 gap-3">
        <div>
            <select name="status" class="w-full px-3 py-2 rounded-xl border border-slate-300 text-sm focus:outline-none focus:ring-2 focus:ring-teal-500 bg-white">
                <option value="">All Statuses</option>
                <option value="Scheduled" selected="@(Model.Status == "Scheduled")">Scheduled</option>
                <option value="Completed" selected="@(Model.Status == "Completed")">Completed</option>
                <option value="Cancelled" selected="@(Model.Status == "Cancelled")">Cancelled</option>
            </select>
        </div>
        <div>
            <input type="date" name="fromDateUtc" value="@(Model.FromDateUtc?.ToString("yyyy-MM-dd"))" 
                   class="w-full px-3 py-2 rounded-xl border border-slate-300 text-sm focus:outline-none focus:ring-2 focus:ring-teal-500" />
        </div>
        <div>
            <input type="date" name="toDateUtc" value="@(Model.ToDateUtc?.ToString("yyyy-MM-dd"))" 
                   class="w-full px-3 py-2 rounded-xl border border-slate-300 text-sm focus:outline-none focus:ring-2 focus:ring-teal-500" />
        </div>
        <div class="flex gap-2">
            <button type="submit" class="flex-1 py-2 px-4 bg-slate-900 hover:bg-slate-800 text-white rounded-xl text-sm font-medium transition">
                Filter
            </button>
            @if (!string.IsNullOrEmpty(Model.Status) || Model.FromDateUtc.HasValue || Model.ToDateUtc.HasValue)
            {
                <a asp-action="Index" class="py-2 px-3 bg-slate-100 hover:bg-slate-200 text-slate-600 rounded-xl text-sm transition flex items-center justify-center">
                    <i class="fa-solid fa-xmark"></i>
                </a>
            }
        </div>
    </form>

    <!-- Table of Appointments -->
    <div class="bg-white rounded-2xl border border-slate-200 shadow-sm overflow-hidden">
        @if (!Model.Appointments.Any())
        {
            <div class="p-12 text-center">
                <i class="fa-regular fa-calendar-xmark text-4xl text-slate-300 mb-3"></i>
                <h3 class="font-bold text-slate-800 text-base">No appointments found</h3>
                <p class="text-slate-500 text-sm mt-1">Try changing filter criteria or schedule a new appointment.</p>
            </div>
        }
        else
        {
            <div class="overflow-x-auto">
                <table class="w-full text-left text-sm border-collapse">
                    <thead>
                        <tr class="border-b border-slate-200 bg-slate-50 text-slate-500 text-xs uppercase tracking-wider font-semibold">
                            <th class="py-3.5 px-4">Patient</th>
                            <th class="py-3.5 px-4">Doctor</th>
                            <th class="py-3.5 px-4">Date & Time (UTC)</th>
                            <th class="py-3.5 px-4">Status</th>
                            <th class="py-3.5 px-4 text-right">Actions</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-slate-100 text-slate-700">
                        @foreach (var appt in Model.Appointments)
                        {
                            <tr class="hover:bg-slate-50/80 transition">
                                <td class="py-3.5 px-4 font-semibold text-slate-900">
                                    @appt.PatientName
                                </td>
                                <td class="py-3.5 px-4">
                                    @appt.DoctorName
                                </td>
                                <td class="py-3.5 px-4 text-xs font-mono text-slate-600">
                                    @appt.StartUtc.ToString("yyyy-MM-dd HH:mm") - @appt.EndUtc.ToString("HH:mm")
                                </td>
                                <td class="py-3.5 px-4">
                                    <span class="px-2.5 py-1 text-xs font-semibold rounded-full 
                                        @(appt.Status == "Scheduled" ? "bg-blue-50 text-blue-700" :
                                          appt.Status == "Completed" ? "bg-emerald-50 text-emerald-700" : "bg-red-50 text-red-700")">
                                        @appt.Status
                                    </span>
                                </td>
                                <td class="py-3.5 px-4 text-right">
                                    <a asp-action="Details" asp-route-id="@appt.Id" 
                                       class="px-3 py-1.5 bg-slate-100 hover:bg-teal-50 text-slate-700 hover:text-teal-700 rounded-lg text-xs font-medium transition">
                                        Details
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            @if (Model.TotalPages > 1)
            {
                <div class="flex items-center justify-between px-4 py-3 border-t border-slate-100 text-xs text-slate-500">
                    <span>Page @Model.Page of @Model.TotalPages (@Model.TotalCount total)</span>
                    <div class="flex gap-2">
                        @if (Model.HasPreviousPage)
                        {
                            <a asp-action="Index" asp-route-page="@(Model.Page - 1)" asp-route-status="@Model.Status"
                               class="px-3 py-1.5 bg-slate-100 hover:bg-slate-200 rounded-lg font-medium text-slate-700 transition">
                                Previous
                            </a>
                        }
                        @if (Model.HasNextPage)
                        {
                            <a asp-action="Index" asp-route-page="@(Model.Page + 1)" asp-route-status="@Model.Status"
                               class="px-3 py-1.5 bg-slate-100 hover:bg-slate-200 rounded-lg font-medium text-slate-700 transition">
                                Next
                            </a>
                        }
                    </div>
                </div>
            }
        }
    </div>
</div>
