@model SmartHealthcare.Presentation.ViewModels.Staff.ResetStaffPasswordViewModel
@{
    ViewData["Title"] = "Reset Staff Password";
}

<div class="max-w-xl mx-auto space-y-6">
    <!-- Breadcrumb -->
    <div class="flex items-center gap-2 text-sm text-slate-500">
        <a asp-action="Index" class="hover:text-teal-600 transition">Staff Management</a>
        <i class="fa-solid fa-chevron-right text-xs text-slate-400"></i>
        <span class="text-slate-800 font-medium">Reset Password</span>
    </div>

    <div class="bg-white rounded-2xl border border-slate-200 shadow-sm p-6 sm:p-8">
        <div class="flex items-center gap-3 pb-6 border-b border-slate-100">
            <div class="w-12 h-12 rounded-xl bg-amber-50 text-amber-600 flex items-center justify-center text-xl">
                <i class="fa-solid fa-key"></i>
            </div>
            <div>
                <h1 class="text-xl font-bold text-slate-900 tracking-tight">Reset Password</h1>
                <p class="text-slate-500 text-sm">Assign a new password for <span class="font-semibold text-slate-700">@Model.Email</span></p>
            </div>
        </div>

        <form asp-action="ResetPassword" asp-route-id="@Model.Id" method="post" class="space-y-5 mt-6">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="Id" />
            <input type="hidden" asp-for="Email" />

            <div asp-validation-summary="ModelOnly" class="p-4 rounded-xl bg-red-50 border border-red-200 text-red-700 text-sm"></div>

            <!-- New Password -->
            <div>
                <label asp-for="NewPassword" class="block text-sm font-semibold text-slate-700 mb-1.5"></label>
                <input asp-for="NewPassword" type="password" placeholder="••••••••"
                       class="w-full px-3.5 py-2.5 rounded-xl border border-slate-300 text-sm focus:outline-none focus:ring-2 focus:ring-teal-500 focus:border-teal-500" />
                <span asp-validation-for="NewPassword" class="text-xs text-red-600 mt-1 block"></span>
                <p class="text-xs text-slate-400 mt-1">Must be at least 6 characters with letters and numbers.</p>
            </div>

            <!-- Confirm Password -->
            <div>
                <label asp-for="ConfirmPassword" class="block text-sm font-semibold text-slate-700 mb-1.5"></label>
                <input asp-for="ConfirmPassword" type="password" placeholder="••••••••"
                       class="w-full px-3.5 py-2.5 rounded-xl border border-slate-300 text-sm focus:outline-none focus:ring-2 focus:ring-teal-500 focus:border-teal-500" />
                <span asp-validation-for="ConfirmPassword" class="text-xs text-red-600 mt-1 block"></span>
            </div>

            <div class="flex items-center justify-end gap-3 pt-4 border-t border-slate-100">
                <a asp-action="Index" class="px-4 py-2.5 rounded-xl border border-slate-300 text-slate-700 hover:bg-slate-50 text-sm font-medium transition">
                    Cancel
                </a>
                <button type="submit" class="px-5 py-2.5 rounded-xl bg-amber-600 hover:bg-amber-700 text-white text-sm font-medium shadow-sm transition">
                    Update Password
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
