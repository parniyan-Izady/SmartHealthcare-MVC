@model SmartHealthcare.Presentation.ViewModels.Staff.EditStaffViewModel
@{
    ViewData["Title"] = "Edit Staff Member";
}

<div class="max-w-2xl mx-auto space-y-6">
    <!-- Breadcrumb -->
    <div class="flex items-center gap-2 text-sm text-slate-500">
        <a asp-action="Index" class="hover:text-teal-600 transition">Staff Management</a>
        <i class="fa-solid fa-chevron-right text-xs text-slate-400"></i>
        <span class="text-slate-800 font-medium">Edit Staff Profile</span>
    </div>

    <div class="bg-white rounded-2xl border border-slate-200 shadow-sm p-6 sm:p-8">
        <div class="flex items-center gap-3 pb-6 border-b border-slate-100">
            <div class="w-12 h-12 rounded-xl bg-slate-100 text-slate-700 flex items-center justify-center text-xl">
                <i class="fa-regular fa-pen-to-square"></i>
            </div>
            <div>
                <h1 class="text-xl font-bold text-slate-900 tracking-tight">Edit Staff Member</h1>
                <p class="text-slate-500 text-sm">Update staff contact details and role assignment</p>
            </div>
        </div>

        <form asp-action="Edit" asp-route-id="@Model.Id" method="post" class="space-y-5 mt-6">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="Id" />

            <div asp-validation-summary="ModelOnly" class="p-4 rounded-xl bg-red-50 border border-red-200 text-red-700 text-sm"></div>

            <!-- Role Selection -->
            <div>
                <label asp-for="Role" class="block text-sm font-semibold text-slate-700 mb-1.5"></label>
                @if (Model.CanChangeRole)
                {
                    <select asp-for="Role" class="w-full px-3.5 py-2.5 rounded-xl border border-slate-300 text-sm focus:outline-none focus:ring-2 focus:ring-teal-500 focus:border-teal-500 bg-white">
                        @foreach (var role in Model.AvailableRoles)
                        {
                            <option value="@role">@role</option>
                        }
                    </select>
                    <span asp-validation-for="Role" class="text-xs text-red-600 mt-1 block"></span>
                }
                else
                {
                    <input type="hidden" asp-for="Role" />
                    <input type="text" value="@Model.Role" disabled 
                           class="w-full px-3.5 py-2.5 rounded-xl border border-slate-200 bg-slate-50 text-slate-500 text-sm cursor-not-allowed" />
                    <p class="text-xs text-slate-400 mt-1">Only SuperAdmin can reassign staff roles.</p>
                }
            </div>

            <!-- Email Address -->
            <div>
                <label asp-for="Email" class="block text-sm font-semibold text-slate-700 mb-1.5"></label>
                <input asp-for="Email" type="email"
                       class="w-full px-3.5 py-2.5 rounded-xl border border-slate-300 text-sm focus:outline-none focus:ring-2 focus:ring-teal-500 focus:border-teal-500" />
                <span asp-validation-for="Email" class="text-xs text-red-600 mt-1 block"></span>
            </div>

            <!-- Phone Number -->
            <div>
                <label asp-for="PhoneNumber" class="block text-sm font-semibold text-slate-700 mb-1.5"></label>
                <input asp-for="PhoneNumber" type="tel" placeholder="+1 (555) 000-0000"
                       class="w-full px-3.5 py-2.5 rounded-xl border border-slate-300 text-sm focus:outline-none focus:ring-2 focus:ring-teal-500 focus:border-teal-500" />
                <span asp-validation-for="PhoneNumber" class="text-xs text-red-600 mt-1 block"></span>
            </div>

            <div class="flex items-center justify-end gap-3 pt-4 border-t border-slate-100">
                <a asp-action="Index" class="px-4 py-2.5 rounded-xl border border-slate-300 text-slate-700 hover:bg-slate-50 text-sm font-medium transition">
                    Cancel
                </a>
                <button type="submit" class="px-5 py-2.5 rounded-xl bg-teal-600 hover:bg-teal-700 text-white text-sm font-medium shadow-sm transition">
                    Save Changes
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
