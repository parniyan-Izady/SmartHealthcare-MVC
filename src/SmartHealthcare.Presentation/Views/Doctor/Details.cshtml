@model DoctorDetailsViewModel
@{
    ViewData["Title"] = $"Dr. {Model.Doctor.FullName}";
}

<div class="max-w-4xl mx-auto space-y-6">
    <!-- Top Back Link -->
    <a asp-action="Index" class="inline-flex items-center gap-2 text-xs font-semibold text-slate-500 hover:text-teal-600">
        <i class="fa-solid fa-arrow-left"></i> Back to Doctors
    </a>

    <!-- Profile Header Card -->
    <div class="bg-white p-8 rounded-2xl border border-slate-200 shadow-sm flex flex-col sm:flex-row items-start sm:items-center justify-between gap-6">
        <div class="flex items-center gap-5">
            <div class="w-20 h-20 rounded-2xl bg-teal-50 text-teal-700 flex items-center justify-center font-bold text-3xl shadow-inner">
                @Model.Doctor.FullName.Substring(0, 1)
            </div>
            <div>
                <div class="flex items-center gap-3">
                    <h1 class="text-2xl font-bold text-slate-900">Dr. @Model.Doctor.FullName</h1>
                    <span class="px-2.5 py-0.5 text-xs font-semibold rounded-full @(Model.Doctor.IsActive ? "bg-teal-50 text-teal-700" : "bg-slate-100 text-slate-500")">
                        @(Model.Doctor.IsActive ? "Active" : "Inactive")
                    </span>
                </div>
                <p class="text-sm font-medium text-teal-600 mt-1">@Model.Doctor.MedicalSpecialty</p>
                <p class="text-xs text-slate-400 mt-0.5">License: @Model.Doctor.MedicalLicenseNumber</p>
            </div>
        </div>

        <div class="flex items-center gap-3 w-full sm:w-auto">
            <a asp-controller="Appointment" asp-action="Book" 
               class="flex-1 sm:flex-none text-center px-4 py-2.5 bg-teal-600 hover:bg-teal-700 text-white text-sm font-medium rounded-xl shadow-sm transition">
                <i class="fa-solid fa-calendar-plus text-xs mr-1"></i> Book Visit
            </a>
            <a asp-action="Edit" asp-route-id="@Model.Doctor.Id" 
               class="px-4 py-2.5 bg-slate-100 hover:bg-slate-200 text-slate-700 text-sm font-medium rounded-xl transition">
                Edit
            </a>
            <form asp-action="Delete" asp-route-id="@Model.Doctor.Id" method="post" onsubmit="return confirm('Are you sure you want to delete this doctor?');" class="inline">
                @Html.AntiForgeryToken()
                <button type="submit" class="p-2.5 text-red-600 hover:bg-red-50 rounded-xl transition" title="Delete">
                    <i class="fa-regular fa-trash-can"></i>
                </button>
            </form>
        </div>
    </div>

    <!-- Details Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <!-- Contact & Location -->
        <div class="bg-white p-6 rounded-2xl border border-slate-200 shadow-sm space-y-4">
            <h2 class="font-bold text-slate-900 text-base border-b border-slate-100 pb-3 flex items-center gap-2">
                <i class="fa-solid fa-address-card text-teal-600"></i> Contact Information
            </h2>
            <div class="space-y-3 text-sm">
                <div>
                    <span class="text-xs text-slate-400 uppercase tracking-wider block">Email Address</span>
                    <span class="font-medium text-slate-800">@Model.Doctor.Email</span>
                </div>
                <div>
                    <span class="text-xs text-slate-400 uppercase tracking-wider block">Office Address</span>
                    <span class="font-medium text-slate-800">@Model.Doctor.OfficeAddress</span>
                </div>
            </div>
        </div>

        <!-- Clinical & Financial -->
        <div class="bg-white p-6 rounded-2xl border border-slate-200 shadow-sm space-y-4">
            <h2 class="font-bold text-slate-900 text-base border-b border-slate-100 pb-3 flex items-center gap-2">
                <i class="fa-solid fa-stethoscope text-teal-600"></i> Consultation Details
            </h2>
            <div class="space-y-3 text-sm">
                <div>
                    <span class="text-xs text-slate-400 uppercase tracking-wider block">Specialty Field</span>
                    <span class="font-medium text-slate-800">@Model.Doctor.MedicalSpecialty</span>
                </div>
                <div>
                    <span class="text-xs text-slate-400 uppercase tracking-wider block">Standard Consultation Fee</span>
                    <span class="font-bold text-teal-600 text-lg">$@Model.Doctor.ConsultationFee</span>
                </div>
            </div>
        </div>
    </div>
</div>
