@model PatientReportViewModel
@{
    ViewData["Title"] = "Patient Reports";
}

<div class="space-y-6">
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
        <div>
            <h1 class="text-2xl font-bold text-slate-900 tracking-tight">Patient Directory & Analytics</h1>
            <p class="text-slate-500 text-sm mt-0.5">High-performance Dapper reports for patient medical activity</p>
        </div>
    </div>

    <!-- Search Form -->
    <form method="get" asp-action="Index" class="bg-white p-4 rounded-2xl border border-slate-200 shadow-sm flex flex-col sm:flex-row gap-3">
        <div class="flex-1 relative">
            <span class="absolute inset-y-0 left-0 pl-3 flex items-center text-slate-400">
                <i class="fa-solid fa-magnifying-glass text-xs"></i>
            </span>
            <input type="text" name="searchTerm" value="@Model.SearchTerm" placeholder="Search patient name, national code, or phone..." 
                   class="w-full pl-9 pr-3 py-2 rounded-xl border border-slate-300 text-sm focus:outline-none focus:ring-2 focus:ring-teal-500 focus:border-teal-500" />
        </div>
        <button type="submit" class="py-2 px-6 bg-slate-900 hover:bg-slate-800 text-white rounded-xl text-sm font-medium transition">
            Search
        </button>
        @if (!string.IsNullOrEmpty(Model.SearchTerm))
        {
            <a asp-action="Index" class="py-2 px-4 bg-slate-100 hover:bg-slate-200 text-slate-600 rounded-xl text-sm transition flex items-center justify-center">
                Clear
            </a>
        }
    </form>

    <!-- Table of Patient Reports -->
    <div class="bg-white rounded-2xl border border-slate-200 shadow-sm overflow-hidden">
        @if (!Model.Reports.Any())
        {
            <div class="p-12 text-center">
                <i class="fa-solid fa-hospital-user text-4xl text-slate-300 mb-3"></i>
                <h3 class="font-bold text-slate-800 text-base">No patient records found</h3>
                <p class="text-slate-500 text-sm mt-1">Try adjusting search query or register new patients.</p>
            </div>
        }
        else
        {
            <div class="overflow-x-auto">
                <table class="w-full text-left text-sm border-collapse">
                    <thead>
                        <tr class="border-b border-slate-200 bg-slate-50 text-slate-500 text-xs uppercase tracking-wider font-semibold">
                            <th class="py-3.5 px-4">Patient Name</th>
                            <th class="py-3.5 px-4">National Code</th>
                            <th class="py-3.5 px-4">Phone Number</th>
                            <th class="py-3.5 px-4">Total Consultations</th>
                            <th class="py-3.5 px-4">Last Visit (UTC)</th>
                            <th class="py-3.5 px-4 text-right">Quick Action</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-slate-100 text-slate-700">
                        @foreach (var patient in Model.Reports)
                        {
                            <tr class="hover:bg-slate-50/80 transition">
                                <td class="py-3.5 px-4 font-semibold text-slate-900">
                                    <div class="flex items-center gap-3">
                                        <div class="w-8 h-8 rounded-full bg-emerald-50 text-emerald-700 flex items-center justify-center font-bold text-xs">
                                            @patient.FullName.Substring(0, 1)
                                        </div>
                                        <span>@patient.FullName</span>
                                    </div>
                                </td>
                                <td class="py-3.5 px-4 font-mono text-xs text-slate-600">
                                    @patient.NationalCode
                                </td>
                                <td class="py-3.5 px-4 text-xs text-slate-600">
                                    @patient.PhoneNumber
                                </td>
                                <td class="py-3.5 px-4">
                                    <span class="px-2.5 py-1 text-xs font-semibold rounded-full bg-slate-100 text-slate-700">
                                        @patient.TotalAppointmentsCount visits
                                    </span>
                                </td>
                                <td class="py-3.5 px-4 text-xs text-slate-500">
                                    @(patient.LastAppointmentDateUtc?.ToString("yyyy-MM-dd HH:mm") ?? "No visits yet")
                                </td>
                                <td class="py-3.5 px-4 text-right">
                                    <a asp-controller="Appointment" asp-action="Book" 
                                       class="px-3 py-1.5 bg-teal-50 hover:bg-teal-100 text-teal-700 rounded-lg text-xs font-semibold transition">
                                        Book Visit
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>
