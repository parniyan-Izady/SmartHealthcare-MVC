@model SmartHealthcare.Presentation.ViewModels.ErrorViewModel
@{
    ViewData["Title"] = "Error";
}

<div class="max-w-xl mx-auto my-12 text-center bg-white p-8 rounded-2xl shadow-sm border border-slate-200">
    <div class="w-16 h-16 mx-auto mb-4 rounded-full bg-red-100 flex items-center justify-center text-red-600">
        <i class="fa-solid fa-triangle-exclamation text-2xl"></i>
    </div>
    <h1 class="text-2xl font-bold text-slate-900 mb-2">An Error Occurred</h1>
    <p class="text-slate-600 mb-6 text-sm">We encountered an unexpected error processing your request.</p>

    @if (Model?.ShowRequestId == true)
    {
        <div class="p-3 bg-slate-50 rounded-lg text-xs font-mono text-slate-500 mb-6">
            <strong>Request ID:</strong> <code>@Model.RequestId</code>
        </div>
    }

    <a asp-controller="Home" asp-action="Index" class="inline-flex items-center gap-2 px-5 py-2.5 rounded-lg bg-teal-600 text-white font-medium hover:bg-teal-700 transition shadow-sm">
        <i class="fa-solid fa-house"></i> Return to Dashboard
    </a>
</div>
