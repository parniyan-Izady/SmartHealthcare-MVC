@model DashboardViewModel
@{
    ViewData["Title"] = "Clinical Dashboard";
}

<div class="space-y-8">
    <!-- Welcome Banner -->
    <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 bg-gradient-to-r from-teal-800 to-slate-900 rounded-2xl p-6 sm:p-8 text-white shadow-lg shadow-teal-900/10">
        <div>
            <h1 class="text-2xl sm:text-3xl font-bold tracking-tight">Healthcare Management Overview</h1>
            <p class="text-teal-100 text-sm mt-1">Real-time stats, medical staff activity, and upcoming patient bookings.</p>
        </div>
        <div class="flex items-center gap-3">
            <a asp-controller="Appointment" asp-action="Book" class="px-4 py-2.5 bg-teal-500 hover:bg-teal-400 text-slate-950 font-semibold rounded-xl text-sm transition shadow-sm flex items-center gap-2">
                <i class="fa-solid fa-calendar-plus"></i> New Appointment
            </a>
            <a asp-controller="Doctor" asp-action="Create" class="px-4 py-2.5 bg-white/10 hover:bg-white/20 text-white font-medium rounded-xl text-sm transition backdrop-blur-sm border border-white/10 flex items-center gap-2">
                <i class="fa-solid fa-user-plus"></i> Add Doctor
            </a>
        </div>
    </div>

    <!-- Stat Metric Cards -->
    <div class="grid grid-cols-1 sm:grid-cols-3 gap-6">
        <!-- Doctors -->
        <div class="bg-white p-6 rounded-2xl border border-slate-200 shadow-sm flex items-center gap-4">
            <div class="w-14 h-14 rounded-xl bg-teal-50 flex items-center justify-center text-teal-600 text-2xl">
                <i class="fa-solid fa-user-doctor"></i>
            </div>
            <div>
                <p class="text-xs font-semibold text-slate-500 uppercase tracking-wider">Active Doctors</p>
                <p class="text-2xl font-bold text-slate-900 mt-1">@Model.TotalDoctors</p>
            </div>
        </div>

        <!-- Appointments -->
        <div class="bg-white p-6 rounded-2xl border border-slate-200 shadow-sm flex items-center gap-4">
            <div class="w-14 h-14 rounded-xl bg-blue-50 flex items-center justify-center text-blue-600 text-2xl">
                <i class="fa-solid fa-calendar-check"></i>
            </div>
            <div>
                <p class="text-xs font-semibold text-slate-500 uppercase tracking-wider">Total Bookings</p>
                <p class="text-2xl font-bold text-slate-900 mt-1">@Model.TotalAppointments</p>
            </div>
        </div>

        <!-- Patients -->
        <div class="bg-white p-6 rounded-2xl border border-slate-200 shadow-sm flex items-center gap-4">
            <div class="w-14 h-14 rounded-xl bg-emerald-50 flex items-center justify-center text-emerald-600 text-2xl">
                <i class="fa-solid fa-hospital-user"></i>
            </div>
            <div>
                <p class="text-xs font-semibold text-slate-500 uppercase tracking-wider">Registered Patients</p>
                <p class="text-2xl font-bold text-slate-900 mt-1">@Model.TotalPatients</p>
            </div>
        </div>
    </div>

    <!-- Grid: Upcoming Appointments & Recent Doctors -->
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
        
        <!-- Upcoming Appointments -->
        <div class="bg-white rounded-2xl border border-slate-200 shadow-sm overflow-hidden flex flex-col">
            <div class="p-6 border-b border-slate-100 flex items-center justify-between">
                <div class="flex items-center gap-2">
                    <i class="fa-solid fa-clock text-teal-600"></i>
                    <h2 class="font-bold text-slate-900">Upcoming Appointments</h2>
                </div>
                <a asp-controller="Appointment" asp-action="Index" class="text-xs font-semibold text-teal-600 hover:text-teal-700">View All &rarr;</a>
            </div>
            <div class="p-6 flex-1 divide-y divide-slate-100">
                @if (!Model.UpcomingAppointments.Any())
                {
                    <div class="py-8 text-center text-slate-400 text-sm">
                        <i class="fa-regular fa-calendar text-3xl mb-2"></i>
                        <p>No upcoming appointments found.</p>
                    </div>
                }
                else
                {
                    @foreach (var appt in Model.UpcomingAppointments)
                    {
                        <div class="py-3.5 first:pt-0 last:pb-0 flex items-center justify-between gap-4">
                            <div>
                                <h3 class="font-semibold text-slate-900 text-sm">@appt.PatientName</h3>
                                <p class="text-xs text-slate-500 mt-0.5">With @appt.DoctorName &bull; @appt.StartUtc.ToString("MMM dd, yyyy HH:mm") UTC</p>
                            </div>
                            <div class="flex items-center gap-3">
                                <span class="px-2.5 py-1 text-xs font-medium rounded-full 
                                    @(appt.Status == "Scheduled" ? "bg-blue-50 text-blue-700" :
                                      appt.Status == "Completed" ? "bg-emerald-50 text-emerald-700" : "bg-red-50 text-red-700")">
                                    @appt.Status
                                </span>
                                <a asp-controller="Appointment" asp-action="Details" asp-route-id="@appt.Id" class="p-1.5 text-slate-400 hover:text-slate-600 rounded">
                                    <i class="fa-solid fa-chevron-right text-xs"></i>
                                </a>
                            </div>
                        </div>
                    }
                }
            </div>
        </div>

        <!-- Featured / Recent Doctors -->
        <div class="bg-white rounded-2xl border border-slate-200 shadow-sm overflow-hidden flex flex-col">
            <div class="p-6 border-b border-slate-100 flex items-center justify-between">
                <div class="flex items-center gap-2">
                    <i class="fa-solid fa-user-doctor text-teal-600"></i>
                    <h2 class="font-bold text-slate-900">Medical Specialists</h2>
                </div>
                <a asp-controller="Doctor" asp-action="Index" class="text-xs font-semibold text-teal-600 hover:text-teal-700">View All &rarr;</a>
            </div>
            <div class="p-6 flex-1 divide-y divide-slate-100">
                @if (!Model.RecentDoctors.Any())
                {
                    <div class="py-8 text-center text-slate-400 text-sm">
                        <i class="fa-solid fa-stethoscope text-3xl mb-2"></i>
                        <p>No doctors registered yet.</p>
                    </div>
                }
                else
                {
                    @foreach (var doc in Model.RecentDoctors)
                    {
                        <div class="py-3.5 first:pt-0 last:pb-0 flex items-center justify-between gap-4">
                            <div class="flex items-center gap-3">
                                <div class="w-10 h-10 rounded-full bg-slate-100 text-slate-700 flex items-center justify-center font-bold text-sm">
                                    @doc.FullName.Substring(0, 1)
                                </div>
                                <div>
                                    <h3 class="font-semibold text-slate-900 text-sm">@doc.FullName</h3>
                                    <p class="text-xs text-slate-500 mt-0.5">@doc.MedicalSpecialty &bull; $@doc.ConsultationFee</p>
                                </div>
                            </div>
                            <a asp-controller="Doctor" asp-action="Details" asp-route-id="@doc.Id" class="px-3 py-1.5 text-xs font-medium text-slate-600 hover:text-teal-600 border border-slate-200 rounded-lg hover:border-teal-200 transition">
                                Profile
                            </a>
                        </div>
                    }
                }
            </div>
        </div>

    </div>
</div>
