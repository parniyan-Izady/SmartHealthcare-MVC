@model LoginViewModel
@{
    ViewData["Title"] = "Log In";
}

<div class="max-w-md mx-auto my-6 bg-white p-8 rounded-2xl border border-slate-200 shadow-sm">
    <div class="text-center mb-6">
        <div class="w-12 h-12 mx-auto mb-3 rounded-xl bg-teal-50 text-teal-600 flex items-center justify-center text-xl">
            <i class="fa-solid fa-lock"></i>
        </div>
        <h1 class="text-2xl font-bold text-slate-900 tracking-tight">Account Login</h1>
        <p class="text-sm text-slate-500 mt-1">Enter your clinical credentials to access your portal</p>
    </div>

    <form asp-controller="Account" asp-action="Login" method="post" class="space-y-4">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="ReturnUrl" />

        <div asp-validation-summary="ModelOnly" class="p-3 bg-red-50 border border-red-200 text-red-700 text-xs rounded-xl"></div>

        <div>
            <label asp-for="Email" class="block text-xs font-semibold text-slate-700 uppercase tracking-wider mb-1.5"></label>
            <div class="relative">
                <span class="absolute inset-y-0 left-0 pl-3 flex items-center text-slate-400">
                    <i class="fa-regular fa-envelope text-sm"></i>
                </span>
                <input asp-for="Email" type="email" placeholder="name@healthcare.com" 
                       class="w-full pl-9 pr-3 py-2.5 rounded-xl border border-slate-300 text-sm focus:outline-none focus:ring-2 focus:ring-teal-500 focus:border-teal-500" />
            </div>
            <span asp-validation-for="Email" class="text-xs text-red-600 mt-1 block"></span>
        </div>

        <div>
            <label asp-for="Password" class="block text-xs font-semibold text-slate-700 uppercase tracking-wider mb-1.5"></label>
            <div class="relative">
                <span class="absolute inset-y-0 left-0 pl-3 flex items-center text-slate-400">
                    <i class="fa-solid fa-key text-sm"></i>
                </span>
                <input asp-for="Password" type="password" placeholder="••••••••" 
                       class="w-full pl-9 pr-3 py-2.5 rounded-xl border border-slate-300 text-sm focus:outline-none focus:ring-2 focus:ring-teal-500 focus:border-teal-500" />
            </div>
            <span asp-validation-for="Password" class="text-xs text-red-600 mt-1 block"></span>
        </div>

        <div class="flex items-center justify-between text-sm pt-1">
            <label class="flex items-center gap-2 text-slate-600 cursor-pointer">
                <input asp-for="RememberMe" type="checkbox" class="w-4 h-4 rounded text-teal-600 focus:ring-teal-500 border-slate-300" />
                <span>Remember me</span>
            </label>
        </div>

        <button type="submit" 
                class="w-full py-2.5 px-4 bg-teal-600 hover:bg-teal-700 text-white font-medium text-sm rounded-xl shadow-sm transition">
            Sign In
        </button>

        <div class="text-center text-xs text-slate-500 pt-4 border-t border-slate-100">
            Don't have an account? 
            <a asp-controller="Account" asp-action="Register" class="text-teal-600 font-semibold hover:underline">Register here</a>
        </div>
    </form>
</div>
