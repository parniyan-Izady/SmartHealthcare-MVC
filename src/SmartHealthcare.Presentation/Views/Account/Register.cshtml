@model RegisterViewModel
@{
    ViewData["Title"] = "Register Account";
}

<div class="max-w-xl mx-auto my-6 bg-white p-8 rounded-2xl border border-slate-200 shadow-sm">
    <div class="text-center mb-6">
        <div class="w-12 h-12 mx-auto mb-3 rounded-xl bg-teal-50 text-teal-600 flex items-center justify-center text-xl">
            <i class="fa-solid fa-user-plus"></i>
        </div>
        <h1 class="text-2xl font-bold text-slate-900 tracking-tight">Create an Account</h1>
        <p class="text-sm text-slate-500 mt-1">Join the SmartHealthcare clinical portal</p>
    </div>

    <form asp-controller="Account" asp-action="Register" method="post" class="space-y-4">
        @Html.AntiForgeryToken()

        <div asp-validation-summary="ModelOnly" class="p-3 bg-red-50 border border-red-200 text-red-700 text-xs rounded-xl"></div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div>
                <label asp-for="FirstName" class="block text-xs font-semibold text-slate-700 uppercase tracking-wider mb-1.5"></label>
                <input asp-for="FirstName" class="w-full px-3 py-2.5 rounded-xl border border-slate-300 text-sm focus:outline-none focus:ring-2 focus:ring-teal-500 focus:border-teal-500" />
                <span asp-validation-for="FirstName" class="text-xs text-red-600 mt-1 block"></span>
            </div>
            <div>
                <label asp-for="LastName" class="block text-xs font-semibold text-slate-700 uppercase tracking-wider mb-1.5"></label>
                <input asp-for="LastName" class="w-full px-3 py-2.5 rounded-xl border border-slate-300 text-sm focus:outline-none focus:ring-2 focus:ring-teal-500 focus:border-teal-500" />
                <span asp-validation-for="LastName" class="text-xs text-red-600 mt-1 block"></span>
            </div>
        </div>

        <div>
            <label asp-for="Email" class="block text-xs font-semibold text-slate-700 uppercase tracking-wider mb-1.5"></label>
            <input asp-for="Email" type="email" class="w-full px-3 py-2.5 rounded-xl border border-slate-300 text-sm focus:outline-none focus:ring-2 focus:ring-teal-500 focus:border-teal-500" />
            <span asp-validation-for="Email" class="text-xs text-red-600 mt-1 block"></span>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div>
                <label asp-for="Password" class="block text-xs font-semibold text-slate-700 uppercase tracking-wider mb-1.5"></label>
                <input asp-for="Password" type="password" class="w-full px-3 py-2.5 rounded-xl border border-slate-300 text-sm focus:outline-none focus:ring-2 focus:ring-teal-500 focus:border-teal-500" />
                <span asp-validation-for="Password" class="text-xs text-red-600 mt-1 block"></span>
            </div>
            <div>
                <label asp-for="ConfirmPassword" class="block text-xs font-semibold text-slate-700 uppercase tracking-wider mb-1.5"></label>
                <input asp-for="ConfirmPassword" type="password" class="w-full px-3 py-2.5 rounded-xl border border-slate-300 text-sm focus:outline-none focus:ring-2 focus:ring-teal-500 focus:border-teal-500" />
                <span asp-validation-for="ConfirmPassword" class="text-xs text-red-600 mt-1 block"></span>
            </div>
        </div>

        <div>
            <label asp-for="Role" class="block text-xs font-semibold text-slate-700 uppercase tracking-wider mb-1.5"></label>
            <select asp-for="Role" asp-items="Html.GetEnumSelectList<SmartHealthcare.Domain.Enums.UserRole>()" 
                    class="w-full px-3 py-2.5 rounded-xl border border-slate-300 text-sm focus:outline-none focus:ring-2 focus:ring-teal-500 focus:border-teal-500 bg-white"></select>
            <span asp-validation-for="Role" class="text-xs text-red-600 mt-1 block"></span>
        </div>

        <button type="submit" 
                class="w-full py-2.5 px-4 bg-teal-600 hover:bg-teal-700 text-white font-medium text-sm rounded-xl shadow-sm transition mt-2">
            Create Account
        </button>

        <div class="text-center text-xs text-slate-500 pt-4 border-t border-slate-100">
            Already have an account? 
            <a asp-controller="Account" asp-action="Login" class="text-teal-600 font-semibold hover:underline">Log in</a>
        </div>
    </form>
</div>
